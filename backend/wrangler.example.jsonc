{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verstobbertje-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verstobbertje",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://REPLACE_WITH_LIVE_APP_DOMAIN",
    "VAPID_PUBLIC_KEY": "BApD0dvRtvencj36u9kLygx2YKVsWmjU-O87G2jyzC0-ZH94Ixsci4nglUOIerDRyFpmLNwuB8vdMqO2DO4FOhg"
  },
  "triggers": {
    "crons": ["0 3 * * *", "* * * * *"]
  }
}
